{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "endOfLine": "lf",
  "ignorePatterns": [
    "dist/**",
    "coverage/**",
    "node_modules/**",
    "package-lock.json",
    "src-tauri/target/**",
    "src-tauri/gen/**",
    "src-tauri/icons/**",
    "src-tauri/migrations/**",
    "AGENTS.md"
  ]
}
