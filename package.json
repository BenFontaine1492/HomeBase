{
  "name": "homebase",
  "private": true,
  "version": "0.0.0",
  "description": "HomeBase – personal household management desktop application",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --runExternalCode && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --runExternalCode",
    "test": "node scripts/vitest.mjs run",
    "test:watch": "node scripts/vitest.mjs",
    "test:coverage": "node scripts/vitest.mjs run --coverage",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "coverage:rust": "cargo llvm-cov --manifest-path src-tauri/Cargo.toml --ignore-filename-regex \"src[\\\\/](main|app|commands)\\.rs$\" --fail-under-lines 100",
    "tauri": "tauri"
  },
  "dependencies": {
    "@mdi/font": "7.4.47",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-log": "^2.10.2",
    "@tauri-apps/plugin-sql": "^2.6.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1",
    "vuetify": "^4.3.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/content-mapper": "4.0.0-alpha.3",
    "@vitest/coverage-v8": "5.1.0",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "7.1.0-beta",
    "vite": "^8.3.8",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "5.1.0"
  },
  "overrides": {
    "typescript": "$typescript"
  }
}
